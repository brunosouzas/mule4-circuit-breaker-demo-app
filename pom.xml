<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!-- groupId is the Anypoint organization (business group) ID, required to publish/deploy this
	     app itself via Exchange - see mulesoft-orders-api's pom.xml and the mule4-circuit-breaker
	     dependency below, which documents the same convention for its own groupId. -->
	<groupId>c17ce335-be76-4fd0-87e2-130837d2c65a</groupId>
	<artifactId>mule4-circuit-breaker-demo-app</artifactId>
	<version>0.1.0-SNAPSHOT</version>
	<packaging>mule-application</packaging>

	<name>mule4-circuit-breaker-demo-app</name>
	<description>Mule 4 application that consumes mule4-circuit-breaker against a controllable simulated backend, so every circuit breaker scenario can be triggered and checked inside a real Mule runtime.</description>
	<url>https://github.com/brunosouzas/mule4-circuit-breaker-demo-app</url>

	<licenses>
		<license>
			<name>MIT</name>
			<url>https://opensource.org/licenses/MIT</url>
		</license>
	</licenses>

	<scm>
		<connection>scm:git:https://github.com/brunosouzas/mule4-circuit-breaker-demo-app.git</connection>
		<developerConnection>scm:git:https://github.com/brunosouzas/mule4-circuit-breaker-demo-app.git</developerConnection>
		<url>https://github.com/brunosouzas/mule4-circuit-breaker-demo-app</url>
		<tag>HEAD</tag>
	</scm>

	<distributionManagement>
		<repository>
			<id>anypoint-exchange-v3</id>
			<name>Anypoint Exchange</name>
			<url>https://maven.anypoint.mulesoft.com/api/v3/organizations/${project.groupId}/maven</url>
			<layout>default</layout>
		</repository>
		<snapshotRepository>
			<id>anypoint-exchange-v3</id>
			<name>Anypoint Exchange</name>
			<url>https://maven.anypoint.mulesoft.com/api/v3/organizations/${project.groupId}/maven</url>
			<layout>default</layout>
		</snapshotRepository>
	</distributionManagement>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<app.runtime>4.9.17</app.runtime>
		<mule.maven.plugin.version>4.9.1</mule.maven.plugin.version>
		<munit.version>3.7.1</munit.version>
		<mule.http.connector.version>1.11.3</mule.http.connector.version>
		<mule.scripting.module.version>2.1.1</mule.scripting.module.version>
		<circuit.breaker.version>1.1.0</circuit.breaker.version>
		<maven.release.plugin.version>3.3.1</maven.release.plugin.version>
		<!-- Deployment values are passed by the pipeline from deployment/<env>.yaml -->
		<deploy.environment>test</deploy.environment>
		<deploy.applicationName>${project.artifactId}-${deploy.environment}</deploy.applicationName>
		<deploy.target>Cloudhub-US-East-2</deploy.target>
		<deploy.runtimeVersion>4.9.0</deploy.runtimeVersion>
		<deploy.releaseChannel>LTS</deploy.releaseChannel>
		<deploy.replicas>1</deploy.replicas>
		<deploy.vCores>0.1</deploy.vCores>
		<deploy.clientId />
		<deploy.clientSecret />
	</properties>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-clean-plugin</artifactId>
				<version>3.4.0</version>
			</plugin>
			<plugin>
				<groupId>org.mule.tools.maven</groupId>
				<artifactId>mule-maven-plugin</artifactId>
				<version>${mule.maven.plugin.version}</version>
				<extensions>true</extensions>
				<configuration>
					<classifier>mule-application</classifier>
					<cloudhub2Deployment>
						<uri>https://anypoint.mulesoft.com</uri>
						<provider>MC</provider>
						<environment>${deploy.environment}</environment>
						<target>${deploy.target}</target>
						<muleVersion>${deploy.runtimeVersion}</muleVersion>
						<releaseChannel>${deploy.releaseChannel}</releaseChannel>
						<javaVersion>17</javaVersion>
						<applicationName>${deploy.applicationName}</applicationName>
						<replicas>${deploy.replicas}</replicas>
						<vCores>${deploy.vCores}</vCores>
						<connectedAppClientId>${deploy.clientId}</connectedAppClientId>
						<connectedAppClientSecret>${deploy.clientSecret}</connectedAppClientSecret>
						<connectedAppGrantType>client_credentials</connectedAppGrantType>
						<properties>
							<mule.env>${deploy.environment}</mule.env>
							<!-- Pin the demo-friendly circuit breaker tuning (same values as
							     common.yaml) so the CloudHub deployment reproduces the README's
							     documented scenarios, instead of inheriting MUnit's fast test
							     values through the coincidence that both environments are
							     named "test". -->
							<cb.windowSize>5</cb.windowSize>
							<cb.minimumCalls>5</cb.minimumCalls>
							<cb.failureRateThreshold>50</cb.failureRateThreshold>
							<cb.resetTimeout>10000</cb.resetTimeout>
							<cb.permittedCallsInHalfOpen>1</cb.permittedCallsInHalfOpen>
							<cb.successThreshold>1</cb.successThreshold>
						</properties>
					</cloudhub2Deployment>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-release-plugin</artifactId>
				<version>${maven.release.plugin.version}</version>
				<configuration>
					<!-- Inert for this issue: the release stage only runs off `main`, which
					     BRU-58 never touches (deploy stays scoped to develop -> test). Present
					     for parity with mulesoft-orders-api and future readiness. -->
					<!-- [skip ci] stops the release commits from triggering the pipeline again. -->
					<scmCommentPrefix>[skip ci] [maven-release-plugin] </scmCommentPrefix>
					<tagNameFormat>v@{project.version}</tagNameFormat>
					<goals>deploy</goals>
					<pushChanges>true</pushChanges>
				</configuration>
			</plugin>
			<plugin>
				<groupId>com.mulesoft.munit.tools</groupId>
				<artifactId>munit-maven-plugin</artifactId>
				<version>${munit.version}</version>
				<executions>
					<execution>
						<id>test</id>
						<phase>test</phase>
						<goals>
							<goal>test</goal>
							<goal>coverage-report</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<runtimeVersion>${app.runtime}</runtimeVersion>
					<runtimeProduct>MULE_EE</runtimeProduct>
					<systemPropertyVariables>
						<mule.env>test</mule.env>
						<cb.windowSize>2</cb.windowSize>
						<cb.minimumCalls>2</cb.minimumCalls>
						<cb.failureRateThreshold>50</cb.failureRateThreshold>
						<cb.resetTimeout>500</cb.resetTimeout>
						<cb.permittedCallsInHalfOpen>1</cb.permittedCallsInHalfOpen>
						<cb.successThreshold>1</cb.successThreshold>
					</systemPropertyVariables>
					<dynamicPorts>
						<dynamicPort>http.port</dynamicPort>
					</dynamicPorts>
					<coverage>
						<runCoverage>true</runCoverage>
						<failBuild>true</failBuild>
						<requiredApplicationCoverage>80</requiredApplicationCoverage>
						<formats>
							<format>console</format>
						</formats>
					</coverage>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<dependencies>
		<dependency>
			<groupId>org.mule.connectors</groupId>
			<artifactId>mule-http-connector</artifactId>
			<version>${mule.http.connector.version}</version>
			<classifier>mule-plugin</classifier>
		</dependency>
		<dependency>
			<groupId>org.mule.modules</groupId>
			<artifactId>mule-scripting-module</artifactId>
			<version>${mule.scripting.module.version}</version>
			<classifier>mule-plugin</classifier>
		</dependency>
		<dependency>
			<!-- groupId is the Anypoint organization (business group) ID the plugin is published
			     under on Exchange, not a Java package name - see mule4-circuit-breaker's own pom.xml. -->
			<groupId>c17ce335-be76-4fd0-87e2-130837d2c65a</groupId>
			<artifactId>mule4-circuit-breaker</artifactId>
			<version>${circuit.breaker.version}</version>
			<classifier>mule-plugin</classifier>
		</dependency>
		<dependency>
			<groupId>com.mulesoft.munit</groupId>
			<artifactId>munit-runner</artifactId>
			<version>${munit.version}</version>
			<classifier>mule-plugin</classifier>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.mulesoft.munit</groupId>
			<artifactId>munit-tools</artifactId>
			<version>${munit.version}</version>
			<classifier>mule-plugin</classifier>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<repositories>
		<repository>
			<id>anypoint-exchange-v3</id>
			<name>Anypoint Exchange</name>
			<url>https://maven.anypoint.mulesoft.com/api/v3/maven</url>
			<layout>default</layout>
		</repository>
		<repository>
			<id>mulesoft-releases</id>
			<name>MuleSoft Releases Repository</name>
			<url>https://repository.mulesoft.org/releases/</url>
			<layout>default</layout>
		</repository>
	</repositories>

	<pluginRepositories>
		<pluginRepository>
			<id>mulesoft-releases</id>
			<name>MuleSoft Releases Repository</name>
			<url>https://repository.mulesoft.org/releases/</url>
			<layout>default</layout>
		</pluginRepository>
	</pluginRepositories>
</project>
